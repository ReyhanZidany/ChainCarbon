# Database Configuration
DB_HOST=mysql_db
DB_USER=chaincarbon_user
DB_PASS=secure_password_here
DB_NAME=chaincarbon_prod

# Backend Configuration
PORT=5000
JWT_SECRET=change_this_to_a_secure_random_string_in_production
FABRIC_API=http://blockchain-api:3000

# Email Configuration (for Notifications)
EMAIL_USER=admin@chaincarbon.com
EMAIL_PASSWORD=secure_app_password

# Frontend Configuration (Build Time)
# These are used by the React build process
REACT_APP_API_BASE_URL=https://api.chaincarbon.com
REACT_APP_STATIC_BASE_URL=https://api.chaincarbon.com
